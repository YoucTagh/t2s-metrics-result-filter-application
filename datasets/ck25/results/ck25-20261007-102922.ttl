<urn:uuid:bb4b2aaf-1753-456e-8563-6e6858b2acdd> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:0980cd90-de30-47d7-b5a8-29d98b9d72dc> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" .

