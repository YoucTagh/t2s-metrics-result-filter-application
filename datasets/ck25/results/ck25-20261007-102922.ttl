<urn:uuid:cae1b431-fd53-45a2-b107-7c4ef306dbd8> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:614d1bcb-146e-4b34-baaa-40d979c3d640> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" .

