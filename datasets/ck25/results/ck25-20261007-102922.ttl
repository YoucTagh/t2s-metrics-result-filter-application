<urn:uuid:22cda383-cd4f-415d-b35f-5dfd064d118a> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:7742ae7f-4dc4-40d9-b027-f4ac04256f36> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ecc: <https://ns.eccenca.com/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?supplier ?name ?addressText ?addressLocality ?addressCountry ?addressCountryCode WHERE {
    ?supplier a pv:Supplier ;
              pv:name ?name .
    OPTIONAL { ?supplier pv:addressText ?addressText . }
    OPTIONAL { ?supplier pv:addressLocality ?addressLocality . }
    OPTIONAL { ?supplier pv:addressCountry ?addressCountry . }
    OPTIONAL { ?supplier pv:addressCountryCode ?addressCountryCode . }
}""" .

<urn:uuid:22d6bba4-680b-454a-b536-6081c8c1a18e> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:08af12ef-6713-4b5e-9487-e6420b9ddaf0> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Encoder> .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .
  ?result pv:hasSupplier ?supplier .
  ?supplier pv:addressCountry ?country .
  FILTER ( (?country = "France") ||  (?country = "Germany") )
}
ORDER BY ASC(?price)
LIMIT 1
""" .

