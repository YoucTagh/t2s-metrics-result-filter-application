<urn:uuid:b4bd07c9-58e4-4ac5-b144-f7b89a032d6e> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:1ff769b0-cbf2-4214-8bd1-b4d766c92bde> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" .

