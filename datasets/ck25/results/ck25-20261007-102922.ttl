<urn:uuid:a19dd1bf-a6b1-4195-aa1b-61c7afccb9cd> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:dca086db-3bcc-4d41-a1be-ebae3e886364> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?hardware pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Inductor> .
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .
}
ORDER BY DESC(?reliabilityIndex)
LIMIT 1
""" .

<urn:uuid:a1a4159f-6d2d-4163-a6f2-9038a6459672> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:30bf9418-f56a-4289-94b5-84e1f06837c9> ;
    t2s:queryText """PREFIX prod: <http://ld.company.org/prod-vocab/>
SELECT ?product ?property ?value
WHERE {
  ?product a prod:Product ;
           ?property ?value
}""" .

<urn:uuid:a1a64176-ce69-454f-a1b5-7f4d5062eb84> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:8739a7d6-07fc-496f-b2bf-07fc13c71f9a> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?supplier ?averageReliability WHERE {
    ?supplier a pv:Supplier.
    OPTIONAL { ?supplier pv:hasProduct ?product }
    OPTIONAL { ?product pv:reliable ?reliabilityValue }
    FILTER (isLiteral(?reliabilityValue))
    BIND (AVG(?reliabilityValue) AS ?averageReliability)
    GROUP BY ?supplier
    ORDER BY DESC(?averageReliability)
    LIMIT 5
}""" .

