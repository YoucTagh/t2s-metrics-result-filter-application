<urn:uuid:2bb42a76-36b1-45fc-ab6e-f809bcc1f60c> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:e58d36d0-58d7-4900-8bc2-ec24c233ec32> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

