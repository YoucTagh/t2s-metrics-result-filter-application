<urn:uuid:a26b5e07-ebb9-4746-8ab2-3d80259b88b4> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:064eb2a6-cb0a-4fc8-bd11-21953f5521e3> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (ROUND(AVG(?amt) * 100) / 100 AS ?avgEur) WHERE {
  ?sup a pv:Supplier ;
    pv:name ?name .
  ?hw pv:hasSupplier ?sup ;
    pv:price/pv:amount ?amt ;
    pv:price/pv:currency "EUR" .
}
GROUP BY ?sup ?name
""" .

<urn:uuid:a280860a-5950-4a0a-aa80-3df632ecf160> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:d9e07b24-ecd6-46d7-97bb-fd180f1d6a63> ;
    t2s:queryText """
PREFIX ns3: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT (COUNT(DISTINCT ?supplier) AS ?supplierCount)
WHERE {
  ?product rdf:type ns3:HardwareShape ;
           ns3:compatibleWith <http://ld.company.org/prod-vocab/K367_Strain_Encoder> .
  ?alternativeProduct rdf:type ns3:HardwareShape ;
                      ns3:compatibleWith ?product ;
                      FILTER (?alternativeProduct != <http://ld.company.org/prod-vocab/K367_Strain_Encoder>) .
  ?supplier rdf:type ns3:SupplierShape ;
            ns3:canDeliver ?alternativeProduct .
}
""" .

