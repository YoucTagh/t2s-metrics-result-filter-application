    t2s:queryText """PREFIX prod: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?country
WHERE {
  ?bom a prod:BOMPart .
  ?bom prod:deliveredFrom ?location .
  ?location rdfs:label ?country .
}""" .

