<urn:uuid:4c064721-be97-42b7-a9e7-ce68dcace683> a t2s:Score ;
    t2s:forMetric t2si:exact_match_spinach ;
    t2s:scoreValue 0.0 .

<urn:uuid:4c071c0a-77e3-41d3-8906-f1bb7dfc98f6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f824bc2e-2c75-46ee-aabf-40e40e9c5b79> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?id ?name ?width
WHERE {
  { # get min-max range
    SELECT (MIN(?width) AS ?minW) (MAX(?width) AS ?maxW)
    WHERE {
      ?hw a pv:Hardware ;
        pv:width_mm ?width .
    }
  }

  # get 90. percentile
  BIND(?minW + (0.9 * (?maxW - ?minW)) AS ?pct90)

  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name ;
    pv:width_mm ?width .

  FILTER(?width >= ?pct90)
}
ORDER BY DESC(?width)
""" .

