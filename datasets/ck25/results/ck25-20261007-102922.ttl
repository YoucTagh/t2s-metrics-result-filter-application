<urn:uuid:7c365d94-e563-45cb-9d05-ff8e36181536> a t2s:Score ;
    t2s:forMetric t2si:recall_qald ;
    t2s:scoreValue 0.0 .

<urn:uuid:7c396f46-609c-4083-9fa4-35c457fed81e> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:eab03743-b369-49b4-9575-f3963054cfbf> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}
""" .

