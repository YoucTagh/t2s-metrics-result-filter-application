<urn:uuid:f647156b-1932-4f60-9194-df2ccb496f5d> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:0d50a1e9-b31d-4d24-8beb-6d220ccd694e> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

