<urn:uuid:fee33a38-d69d-4439-b88b-d70ca834c95a> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:9e22ae01-17f4-4258-adc0-122f5d73ab19> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

