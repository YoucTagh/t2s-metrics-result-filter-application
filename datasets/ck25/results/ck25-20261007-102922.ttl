<urn:uuid:ba8031ef-8c01-4363-9ce6-566b33b5f871> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:ef49de99-c5c1-432b-bc17-538a25d7840a> ;
    t2s:queryText """
PREFIX ns3: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?department
WHERE {
  ?department rdf:type ns3:Department .
  FILTER NOT EXISTS {
    ?manager rdf:type ns3:Manager .
    ?department ns3:hasManager ?manager .
  }
}
""" .

