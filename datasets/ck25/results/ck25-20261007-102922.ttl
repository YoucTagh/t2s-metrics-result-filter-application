<urn:uuid:81ce1af6-ab35-4eac-acdf-9173722d2c7f> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:75df752f-12e8-4980-9017-34c3ffacffc2> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?id ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name .
  FILTER NOT EXISTS { ?hw pv:hasProductManager/pv:name [] . }
}
""" .

