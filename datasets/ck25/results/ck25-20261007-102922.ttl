<urn:uuid:0fbfdffb-f6be-4e56-9903-d23ba07b5253> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:ec399262-d7b8-4791-81e3-8702089461e1> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?locality ?ccode ?country
WHERE {
  ?sup a pv:Supplier ;
    pv:name ?name .
  OPTIONAL { ?sup pv:addressLocality ?locality . }
  OPTIONAL { ?sup pv:addressCountryCode ?ccode . }
  OPTIONAL { ?sup pv:addressCountry ?country . }
}
""" .

