<urn:uuid:f1acbb88-7b21-49e6-a422-fa532006c1eb> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:a7bf5e52-5a4b-4926-8987-fe98d0acd8cf> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?compatibleProduct ?priceDiff WHERE {
  <http://ld.company.org/prod-instances/{resource_id}> a pv:Product ;
    pv:compatibleProduct ?compatibleProduct;
    pv:price ?price1.
  <http://ld/company.org/prod-instances/{other_resource_id}> a pv:Product ;
    pv:compatibleProduct ?otherCompatibleProduct;
    pv:price ?price2.
  FILTER (?compatibleProduct = ?otherCompatibleProduct)
  BIND(?price2 - ?price1 AS ?priceDiff)
}""" .

