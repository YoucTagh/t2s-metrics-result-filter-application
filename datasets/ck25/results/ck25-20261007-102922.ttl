<urn:uuid:a3fb7094-ae85-4d33-8f60-42c03945cca1> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:6fac4b57-6370-4303-8737-01be6cad3644> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?id ?name ?width
WHERE {
  { # get min-max range
    SELECT (MIN(?width) AS ?minW) (MAX(?width) AS ?maxW)
    WHERE {
      ?hw a pv:Hardware ;
        pv:width_mm ?width .
    }
  }

  # get 90. percentile
  BIND(?minW + (0.9 * (?maxW - ?minW)) AS ?pct90)

  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name ;
    pv:width_mm ?width .

  FILTER(?width >= ?pct90)
}
ORDER BY DESC(?width)
""" .

