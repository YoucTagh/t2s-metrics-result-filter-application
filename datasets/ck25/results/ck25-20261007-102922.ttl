<urn:uuid:d6c7bf28-1628-4151-a670-1bda9ba2476e> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:13cb2cd4-9143-4144-b19b-d7d76cc57b34> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

