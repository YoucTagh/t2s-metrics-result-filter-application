<urn:uuid:8ff9a8b6-33c3-4762-ac06-915ba42533f4> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:c9d1b402-c043-4067-9f61-7f6d6132728c> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  <http://ld.company.org/prod-instances/bom-17> pv:hasBomPart ?bomPart .
  ?bomPart pv:hasPart ?product .
  ?product pv:hasSupplier ?supplier .
  ?supplier pv:country ?result
}
""" .

