<urn:uuid:062586a1-ff67-43a0-bba6-4402c390e185> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f24386ce-979e-43ed-90cb-c250a0fc7bb3> ;
    t2s:queryText "PREFIX n1: <http://ld.company.org/prod-vocab/> SELECT DISTINCT ?hasBomPart_20 WHERE { ?BillOfMaterial_1 a n1:BillOfMaterial . ?BillOfMaterial_1 n1:hasBomPart ?hasBomPart_20 . } GROUP BY ?hasBomPart_20 ORDER BY DESC(COUNT(DISTINCT ?BillOfMaterial_1)) LIMIT 1" .

