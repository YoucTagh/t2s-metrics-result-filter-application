<urn:uuid:227894a2-8b7f-4b27-86b9-3cb6248b956c> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:b58f695e-6b3e-4875-abef-76f02f9c66d9> ;
    t2s:queryText """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?hardware ?hardwareId ?hardwareName WHERE {
  ?hardware rdf:type/rdfs:subClassOf* <http://ld.company.org/prod-vocab/Hardware> .
  ?hardware <http://ld.company.org/prod-vocab/id> ?hardwareId .
  ?hardware <http://ld.company.org/prod-vocab/name> ?hardwareName .
  FILTER NOT EXISTS {
    ?hardware <http://ld.company.org/prod-vocab/hasProductManager> ?pm .
  }
}
""" .

