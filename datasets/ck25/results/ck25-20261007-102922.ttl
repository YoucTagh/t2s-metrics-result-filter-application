    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>PREFIX pv: <http://ld.company.org/prod-vocab/>PREFIX prodi: <http://ld.company.org/prod-instances/>SELECT ?billOfMaterial (AVG(?amount) AS ?averageUnitCost)WHERE {    ?billOfMaterial rdf:type pv:BillOfMaterial .    ?billOfMaterial pv:hasPart ?part .    ?part rdf:type pv:Hardware .    ?part pv:price ?price .    ?price pv:amount ?amount .}GROUP BY ?billOfMaterialORDER BY DESC(?averageUnitCost)LIMIT 1""" .

