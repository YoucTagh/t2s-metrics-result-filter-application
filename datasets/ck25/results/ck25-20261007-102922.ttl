<urn:uuid:b9b09878-c3e0-4525-ae33-ed02ec7c6ee6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:c05dbeb7-1d44-409d-b0d3-8535a329f908> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?bom WHERE {
  ?bom rdf:type pv:BillOfMaterial.
  EXISTS {
    ?part pv:hasBomPart ?bom.
    ?part pv:hasSupplier ?supplier.
    ?supplier pv:country "Poland".
  }
}""" .

