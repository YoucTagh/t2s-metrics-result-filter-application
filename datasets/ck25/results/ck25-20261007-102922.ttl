<urn:uuid:e48e5e3a-91bd-4561-8597-c0ae4d8184e6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:91383ab9-8f07-4753-b026-cc5c52e1af5a> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT (COUNT(?supplier) AS ?result)
WHERE
{
  <http://ld.company.org/prod-instances/hw-K367-1320550> pv:compatibleProduct ?alternative .
  ?alternative pv:hasSupplier ?supplier .
}
""" .

