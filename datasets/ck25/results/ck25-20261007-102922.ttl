<urn:uuid:755ce880-d438-46fb-8902-62e9850df626> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:67bb05b7-3250-4a81-aff1-a2b45ab27f96> ;
    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?product ?productLabel WHERE {
  <http://ld.company.org/prod-instances/hw-U990-5234138> <http://ld.company.org/prod-vocab/compatibleProduct> ?product .
  OPTIONAL { ?product rdfs:label ?productLabel . }
}""" .

