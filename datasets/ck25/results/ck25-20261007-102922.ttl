    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>PREFIX pv: <http://ld.company.org/prod-vocab/>PREFIX prodi: <http://ld.company.org/prod-instances/>SELECT ?areaOfExpertise (COUNT(?employee) AS ?count) WHERE {  ?employee rdf:type pv:Employee ;            pv:areaOfExpertise ?areaOfExpertise .}GROUP BY ?areaOfExpertiseORDER BY DESC(?count)LIMIT 3""" .

