<urn:uuid:ae82e9ac-efe7-48e9-9907-c6effb6a7955> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:4672f285-fee0-45ab-9053-4b4557c1ee16> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?country ?price
WHERE {
  ?sup a pv:Supplier ;
    pv:addressCountry ?country ;
  pv:name ?name .
  ?hw a pv:Hardware ;
  pv:price/pv:amount ?price ;
    pv:price/pv:currency "EUR" ;
    pv:hasSupplier ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 10
""" .

