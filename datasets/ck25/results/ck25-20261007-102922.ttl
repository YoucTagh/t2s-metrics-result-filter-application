<urn:uuid:667f92b0-88d4-4491-a0ba-4d8da77c8927> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:75ccad0a-b2bb-4dc3-a252-ce5d12a1fb84> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

