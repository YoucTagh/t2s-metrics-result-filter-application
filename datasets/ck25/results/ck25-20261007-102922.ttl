<urn:uuid:013e893c-bda2-4e49-8905-025ba0b40ef0> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:2fd18c30-044c-4e7e-8aa1-2a2c2e0a7067> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>PREFIX pv: <http://ld.company.org/prod-vocab/>SELECT DISTINCT ?id ?name ?widthWHERE {  ?hardware rdf:type pv:Hardware ;            pv:id ?id ;            pv:name ?name ;            pv:width_mm ?width .  {    SELECT (MAX(?width) * 0.9 AS ?top10Percent)    WHERE {      ?hardware rdf:type pv:Hardware ;                pv:width_mm ?width .    }  }  FILTER(?width >= ?top10Percent)}ORDER BY DESC(?width)""" .

