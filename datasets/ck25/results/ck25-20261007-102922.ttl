<urn:uuid:00b2049b-0224-48d4-a8a9-270459aa9cd4> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:3098e5c6-7dc1-41f0-8eac-7bd35428378e> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

