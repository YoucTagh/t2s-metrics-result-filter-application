<urn:uuid:df6ccc5b-7f3a-4eb3-98a4-5ee37f5ff656> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:97f491c1-858e-414c-abca-c06a608081fa> ;
    t2s:queryText "PREFIX n1: <http://ld.company.org/prod-vocab/> SELECT DISTINCT ?hasSupplier_50 ?thing_4 WHERE { ?thing_4 n1:hasSupplier ?hasSupplier_50 . FILTER ( REGEX(str(?thing_4), \"supplier\", 'i') ) FILTER ( ( REGEX(str(?hasSupplier_50), \"#\", 'i') && REGEX(str(?hasSupplier_50), \"For\", 'i') && REGEX(str(?hasSupplier_50), \"each\", 'i') && REGEX(str(?hasSupplier_50), \"supplier,\", 'i') && REGEX(str(?hasSupplier_50), \"do\", 'i') && REGEX(str(?hasSupplier_50), \"the\", 'i') && REGEX(str(?hasSupplier_50), \"following:beginScope\", 'i') ) ) FILTER ( ( REGEX(str(?hasSupplier_50), \"#\", 'i') && REGEX(str(?hasSupplier_50), \"Start\", 'i') && REGEX(str(?hasSupplier_50), \"a\", 'i') && REGEX(str(?hasSupplier_50), \"new\", 'i') && REGEX(str(?hasSupplier_50), \"scope\", 'i') && REGEX(str(?hasSupplier_50), \"for\", 'i') && REGEX(str(?hasSupplier_50), \"each\", 'i') && REGEX(str(?hasSupplier_50), \"iterationproperty\", 'i') && REGEX(str(?hasSupplier_50), \"name\", 'i') ) ) } LIMIT 200" .

