<urn:uuid:9f63cd7e-3766-44a8-ae39-db3fb31ed035> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:91d1d680-fa58-4631-92ad-652bdf047c00> ;
    t2s:queryText """PREFIX : <http://ld.company.org/prod-vocab/>
SELECT ?department ?employeeName (COUNT(?employee) AS ?employeeCount)
WHERE {
  ?employee a :Employee ;
            :memberOf ?department ;
            :name ?employeeName .
}
GROUP BY ?department ?employeeName
HAVING (COUNT(?employee) > 5)""" .

