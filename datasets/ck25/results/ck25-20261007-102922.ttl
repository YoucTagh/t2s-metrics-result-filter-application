    t2s:queryText "PREFIX prod: <http://ld.company.org/prod-vocab/> SELECT DISTINCT ?productA ?productB WHERE { ?productA prod:compatibleProduct ?productB . ?productB prod:compatibleProduct ?productA . FILTER(?productA != ?productB) }" .

