<urn:uuid:9ca3c1cc-29de-4eb8-9f69-ba25f3836d18> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:57cff939-64e3-46fd-a0d4-64f86a7b5a65> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" .

