    t2s:hasResultSet <urn:uuid:f1bcba43-2321-44c0-ab6d-a9ad65ef0c2d> ;
    t2s:queryText "PREFIX : <http://ld.company.org/prod-vocab/> SELECT ?service ?price WHERE { ?service a :Service ; :price ?price . } ORDER BY DESC(?price) LIMIT 1" .

<urn:uuid:f59a634c-7d0c-4c8c-80a7-07f76c6aeba2> a t2s:Score ;
