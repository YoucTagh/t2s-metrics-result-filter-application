<urn:uuid:cde8447f-5009-4ccf-8af8-d5ef055eaa4b> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:9aa98f15-4083-46e1-a021-fba7ff38f0f4> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?id ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name .
  FILTER NOT EXISTS { ?hw pv:hasProductManager/pv:name [] . }
}
""" .

