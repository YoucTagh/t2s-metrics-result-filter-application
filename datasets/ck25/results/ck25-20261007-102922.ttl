<urn:uuid:9efe48c4-9199-44ae-b300-ffa52dc8ba19> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:6623fbd4-5eb3-4f9a-9162-7774682a8190> ;
    t2s:queryText """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?service ?serviceLabel WHERE {
  ?service rdf:type/rdfs:subClassOf* <http://ld.company.org/prod-vocab/Service> .
  OPTIONAL { ?service rdfs:label ?serviceLabel }
} LIMIT 5""" .

