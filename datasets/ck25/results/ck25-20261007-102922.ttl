    t2s:hasResultSet <urn:uuid:34f87344-93bc-40f1-8656-0982179a24e7> ;
    t2s:queryText """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?productA ?productALabel ?productB ?productBLabel WHERE {
  ?productA <http://ld.company.org/prod-vocab/compatibleProduct> ?productB .
  ?productB <http://ld.company.org/prod-vocab/compatibleProduct> ?productA .
  FILTER(?productA < ?productB)
  OPTIONAL { ?productA rdfs:label ?productALabel }
  OPTIONAL { ?productB rdfs:label ?productBLabel }
}""" .

