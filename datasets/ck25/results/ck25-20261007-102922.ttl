<urn:uuid:056dcffd-ca74-4faf-be7f-1c63536d1c88> a t2s:Score ;
    t2s:forMetric t2si:query_execution ;
    t2s:scoreValue 1.0 .

<urn:uuid:057a0f6c-d4cc-4dc9-9e25-24bf6c2e7785> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:2267df02-b858-4629-8e1a-a82663d85912> ;
    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prod: <http://ld.company.org/prod-vocab/>
PREFIX prodInst: <http://ld.company.org/prod-instances/>

SELECT DISTINCT ?supplier WHERE {
  ?product prod:hasSupplier ?supplier .
  ?product rdf:type ?productType .
  ?productType rdfs:subClassOf* prodInst:prod-cat-Compensator .
  ?supplier prod:country <http://dbpedia.org/resource/France> .
}
""" .

<urn:uuid:057ecf96-0e8f-4d83-a2f3-042c58e45851> a t2s:Score ;
