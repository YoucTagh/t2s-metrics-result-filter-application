    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" .

