<urn:uuid:64e0e24a-e253-481a-9313-a7779561f151> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:b0a4c447-3fe1-417c-91bf-70df843f0458> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Oscillator> .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .
}
ORDER BY ASC(?price)
LIMIT 1
""" .

