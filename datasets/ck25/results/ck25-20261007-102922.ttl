<urn:uuid:da8e8867-d50c-4e42-a082-e84b6a4f0b73> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:94a89aa7-175c-4feb-a770-98bc7248f5ee> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

