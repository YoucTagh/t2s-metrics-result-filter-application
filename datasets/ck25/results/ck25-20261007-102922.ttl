<urn:uuid:16c9ac67-e571-4390-9f95-3f6e6540c7ea> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:7fe43e98-3f12-45d0-ac2d-27b7433c5dc2> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?property ?value WHERE {
  <http://ld.company.org/prod-instances/{resource_id}> ?property ?value.
  FILTER (?property IN (responsibleFor, price))
}""" .

