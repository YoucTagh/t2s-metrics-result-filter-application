<urn:uuid:dca485bd-f188-476a-a4ca-934fb092314e> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:379d3e77-3a95-4b51-8b29-a5fafe1d41aa> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

