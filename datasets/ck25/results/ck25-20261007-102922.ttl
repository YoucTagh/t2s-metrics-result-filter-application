<urn:uuid:0165d550-ab93-4853-b556-24a90e8de03c> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:41c161a4-9255-4108-806d-1bb168abc2bc> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}
""" .

