<urn:uuid:216058d5-71c3-4ed9-971a-f4875355eb49> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:0f118e9a-0f2c-4b7d-aa83-b7ca5232fd79> ;
    t2s:queryText """
PREFIX ns3: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?hardware ?name
WHERE {
  ?hardware rdf:type ns3:Hardware ;
            ns3:name ?name .
  FILTER NOT EXISTS {
    ?hardware ns3:hasProductManager ?productManager .
    ?productManager ns3:status "active" .
  }
}
""" .

