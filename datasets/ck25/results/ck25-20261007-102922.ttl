<urn:uuid:7adec21e-4a92-4b38-8bd8-99ea442927fc> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:bd73cccc-e3d8-49f3-91b5-ebd254013645> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

<urn:uuid:7ae09f12-80f4-4556-b204-f797a581f7b6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:58a6bfe5-1633-43b9-ba97-d11dadc1e746> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" .

