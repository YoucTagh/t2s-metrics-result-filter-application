<urn:uuid:ebf977e8-db00-4ba7-b013-b01ebf3a3f7d> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f0b5ba4a-2ead-434c-900a-8aed7d3e0960> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX bom: <http://example.org/bom#>  # Replace with actual BOM namespace

SELECT ?bom_id (AVG(?unit_cost) AS ?average_unit_cost)
WHERE {
  ?bom a bom:BillOfMaterial .
  ?bom bom:hasPart ?part .
  ?part rdf:type bom:HardwarePart .
  ?part bom:unitCost ?unit_cost .
}
GROUP BY ?bom_id
ORDER BY DESC(?average_unit_cost)
LIMIT 1""" .

