<urn:uuid:bbd4f8ab-985b-42d2-8c0c-8abbb36f081d> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:aa889b1d-128e-4191-a4c6-59ff55c9514c> ;
    t2s:queryText """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (COUNT(?part) AS ?partCount) (SUM(?qty) AS ?totalQty)
WHERE {
  ?bom a pv:BillOfMaterial ;
    pv:hasBomPart ?part .
  ?part pv:quantity ?qty_ .
  BIND(xsd:int(?qty_) AS ?qty)
}
GROUP BY ?bom
HAVING (SUM(?qty) > 600)
ORDER BY DESC(SUM(?qty))
""" .

<urn:uuid:bbd6d97f-fbf6-4e99-a0bf-891b7b9cb7d7> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:723c7ac5-de32-44a6-a502-e369fa36deef> ;
    t2s:queryText """PREFIX : <http://ld.company.org/prod-vocab/>
SELECT (MAX(?partCount) AS ?maxPartCount)
WHERE {
  ?bom a :BillOfMaterial ;
       :hasBomPart ?bomPart .
  {
    SELECT ?bom (COUNT(?bomPart) AS ?partCount)
    WHERE {
      ?bom :hasBomPart ?bomPart .
    }
    GROUP BY ?bom
  }
}""" .

