<urn:uuid:906807fa-750e-4724-99a4-67fa8375fbd6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:78afa971-78db-4fde-805b-709ad711b998> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat (MIN(?w) AS ?minWeight) (MAX(?w) AS ?maxWeight)
WHERE {
  ?catItem a pv:ProductCategory ;
    pv:name ?cat .
  ?hw a pv:Hardware ;
    pv:hasCategory ?catItem ;
    pv:weight_g ?w .
}
GROUP BY ?cat
""" .

<urn:uuid:906ab442-9625-4ed5-9fd0-fff6adcc1be7> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:be2cb7a0-74b7-4538-89ac-520eeca5b71c> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?id ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name .
  FILTER NOT EXISTS { ?hw pv:hasProductManager/pv:name [] . }
}
""" .

