<urn:uuid:c1062ca4-65d4-4507-a633-0ec1a18ee834> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:5d23e686-e592-498c-bc6d-07fa4d6cee41> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?id ?name WHERE {
  ?item a pv:HardwareItem .
  ?item pv:id ?id .
  ?item pv:name ?name .
  FILTER NOT EXISTS { ?item pv:hasProductManager ?product_manager }
}""" .

<urn:uuid:c1074310-d98d-4cba-b10f-f444b078fcaa> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:c664d1cf-3059-4c5b-8ff6-cf999fc9fb9b> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Encoder> .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .
  ?result pv:hasSupplier ?supplier .
  ?supplier pv:addressCountry ?country .
  FILTER ( (?country = "France") ||  (?country = "Germany") )
}
ORDER BY ASC(?price)
LIMIT 1
""" .

