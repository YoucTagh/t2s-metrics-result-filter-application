<urn:uuid:756b1d5e-0e62-412e-8411-1ca51605bab7> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f4756afa-54b1-490e-8a4c-397724947ab7> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" .

