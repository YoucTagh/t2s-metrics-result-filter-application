<urn:uuid:5ffffbc5-9656-49b0-a71a-d2824fde3ce6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:e04a87f3-1547-4583-9fe8-1493c74919bf> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT (COUNT(DISTINCT ?supplier) AS ?supplierCount)
WHERE {
  ?encoder rdfs:label "K367 Strain Encoder" .
  ?supplier schema:offers ?product .
  ?product schema:compatibleWith ?compatibleProduct .
  ?compatibleProduct rdfs:label ?compatibleLabel .
  FILTER (STRSTARTS(STR(?compatibleLabel), "Alternative"))
}""" .

