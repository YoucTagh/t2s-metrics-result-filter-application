<urn:uuid:65c0a125-0898-4a3c-958d-bd028a39ed2a> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:d85ee974-6980-4360-85ef-c4d82e42c80d> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

