<urn:uuid:0c3a0eb1-7a44-4b52-846c-ba4fa7d50176> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:bbe356ba-b573-4e6f-a2b5-269a132718cd> ;
    t2s:queryText """PREFIX : <http://ld.company.org/prod-vocab/>
SELECT ?bom (AVG(?amount) AS ?averageCost)
WHERE {
  ?bom a :BillOfMaterial ;
       :hasBomPart ?bomPart .
  ?bomPart :hasPart ?product .
  ?product a :Hardware ;
           :price ?price .
  ?price :amount ?amount .
}
GROUP BY ?bom
ORDER BY DESC(?averageCost)
LIMIT 1""" .

