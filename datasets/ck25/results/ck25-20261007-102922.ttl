<urn:uuid:6c6d662c-8fc5-4678-98cd-9af5beff4db2> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:eaa6b6a0-8ef8-4769-8425-8106ee72d858> ;
    t2s:queryText """PREFIX : <http://ld.company.org/prod-vocab/>
SELECT ?name ?email ?phone
WHERE {
  ?employee a :Employee ;
            :name ?name ;
            :email ?email ;
            :phone ?phone .
  FILTER NOT EXISTS { ?otherEmployee :hasManager ?employee }
}
ORDER BY ?name""" .

