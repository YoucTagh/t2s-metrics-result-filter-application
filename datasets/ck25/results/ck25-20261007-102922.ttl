<urn:uuid:5edee91c-e245-4e6f-8738-17bd08330173> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:51531b7a-72b8-43ea-bc31-5e2a3da62690> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?property ?value WHERE {
    <http://ld.company.org/prod-instances/suppl-[uuid]> ?property ?value.
    FILTER (?property IN (pv:country, pv:hasSupplier, pv:price))
}

FILTER regex(str(?value), 'French|German', 'i')
FILTER (?property = pv:price)""" .

<urn:uuid:5ee1e601-644b-43d3-97b4-c412950c3cfc> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:6e7be74a-18cc-422a-b8f5-22deb69ef114> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (AVG(?reliabilityIndex) AS ?averageReliabilityIndex)
WHERE
{
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .
}
GROUP BY ?result
ORDER BY DESC(?averageReliabilityIndex)
LIMIT 5
""" .

