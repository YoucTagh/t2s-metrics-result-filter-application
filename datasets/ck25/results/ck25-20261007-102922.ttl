<urn:uuid:f5a13a2d-7d1e-4f0f-8db1-a05506e61a4d> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:1a3e892a-1fcd-4ae0-99bb-1af215a4063b> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

