<urn:uuid:467920b5-e64f-4bb8-9f23-7d508abe1d71> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:887f9f0d-34e8-467e-b8b8-18ec899fb690> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" .

