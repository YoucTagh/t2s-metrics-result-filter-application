<urn:uuid:7aeee2f6-3aa5-497c-b32e-b12fe3053390> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:53560530-c876-4133-876c-47414b9059e5> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat (MIN(?w) AS ?minWeight) (MAX(?w) AS ?maxWeight)
WHERE {
  ?catItem a pv:ProductCategory ;
    pv:name ?cat .
  ?hw a pv:Hardware ;
    pv:hasCategory ?catItem ;
    pv:weight_g ?w .
}
GROUP BY ?cat
""" .

