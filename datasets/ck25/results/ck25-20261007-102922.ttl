<urn:uuid:ab2de2cb-a2e0-4b2f-bac2-37fba1c334f9> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:011012a9-b7b3-4910-a026-69d185ea83d0> ;
    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?manager ?managerLabel WHERE {
  BIND(<http://ld.company.org/prod-instances/empl-Waldtraud.Kuttner%40company.org> AS ?manager)
  OPTIONAL { ?manager rdfs:label ?managerLabel }
}""" .

