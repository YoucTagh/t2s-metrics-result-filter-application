<urn:uuid:10c28a76-4188-4137-b2c5-ba4b657fa9d5> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:60951519-036f-4593-853f-b94425f17ab4> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

