    t2s:queryText "PREFIX ns1: <http://ld.company.org/prod-vocab/> SELECT DISTINCT ?product ?supplier ?country WHERE { ?supplier ns1:country ?country . ?country = <http://dbpedia.org/resource/United_States> . ?product ns1:hasSupplier ?supplier . ?product ns1:compatibleProduct <http://ld.company.org/prod-instances/hw-U990-5234138> . }" .

