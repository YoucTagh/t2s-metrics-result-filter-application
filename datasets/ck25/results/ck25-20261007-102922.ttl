<urn:uuid:6cb03261-068a-4555-83c6-27f82cc20f61> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:3ccb8ffc-372d-47b3-a0ca-6f4576f66b84> ;
    t2s:queryText """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX : <http://ld.company.org/prod-schema#>
SELECT ?coil ?weight
WHERE {
  ?coil a :Coil .
  ?coil :baseArea <15> .
  ?coil :baseAreaUnit "millimeter"^^xsd:string .
  ?coil :weight ?weight .
  FILTER (?weight >= 0)
}
ORDER BY DESC(?weight)
LIMIT 1""" .

