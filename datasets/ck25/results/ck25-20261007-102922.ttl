<urn:uuid:a453d916-ab84-49db-bfb3-16c3ebd9978b> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:fe4bfea8-3e6a-4dc5-8a5b-ae698565796c> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?service a pv:Service .
  ?service pv:hasProductManager ?result .
  ?service pv:price ?priceR .
  ?priceR pv:amount ?price .
}
ORDER BY DESC(?price)
LIMIT 1
""" .

