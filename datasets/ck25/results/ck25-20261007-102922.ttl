<urn:uuid:6c004c7f-5b7b-4f0b-86de-46ef4dfa3081> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:566a2680-a659-4ae0-8794-4c5f271f197a> ;
    t2s:queryText "SELECT ?hardwareID ?name ?width WHERE { ?hardware a :HardwareItem; :hasID ?hardwareID; :hasName ?name; :hasWidth ?width. { SELECT ?width (COUNT(?w) AS ?rank) WHERE { ?item a :HardwareItem; :hasWidth ?w. } GROUP BY ?width ORDER BY DESC(?width) } FILTER(?rank <= (CEIL((SELECT (COUNT(?x) AS ?total) WHERE { ?x a :HardwareItem; :hasWidth ?y. }) * 0.1))) } ORDER BY DESC(?width)" .

