<urn:uuid:d8c6eb46-cede-4ea1-9d73-6955a2e19ebb> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:fe9701e7-597d-4a53-9a5e-c78e90019bd7> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

