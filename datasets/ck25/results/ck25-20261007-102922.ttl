<urn:uuid:ab323af3-37ad-4fc4-ab08-6074d78d6c2c> a t2s:ResultSet ;
    t2s:resultSetValueJSON "{\"head\": {\"vars\": [\"cat\", \"name\"]}, \"meta\": {\"query-time-ms\": 12, \"result-size-total\": 3}, \"results\": {\"bindings\": [{\"cat\": {\"type\": \"uri\", \"value\": \"http://ld.company.org/prod-instances/prod-cat-Compensator\"}, \"name\": {\"type\": \"literal\", \"value\": \"Compensator\"}}, {\"cat\": {\"type\": \"uri\", \"value\": \"http://ld.company.org/prod-instances/prod-cat-Crystal\"}, \"name\": {\"type\": \"literal\", \"value\": \"Crystal\"}}, {\"cat\": {\"type\": \"uri\", \"value\": \"http://ld.company.org/prod-instances/prod-cat-LCD\"}, \"name\": {\"type\": \"literal\", \"value\": \"LCD\"}}]}}" .

<urn:uuid:ab364652-678d-42f6-b6b8-fcf4af59345d> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:dfaed7f0-a4be-442d-8be1-fc7925fb7bd9> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ecc: <https://ns.eccenca.com/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX prodi: <http://ld.company.org/prod-instances/>

SELECT ?encoder ?priceAmount WHERE {
    ?encoder a pv:Hardware ;
        pv:hasCategory prodi:encoderCategory ;
        pv:price ?price ;
        pv:hasSupplier ?supplier .
        
    ?price pv:amount ?priceAmount ;
        pv:currency "EUR" .
        
    ?supplier pv:addressCountry ?country .
    FILTER (?country = "France" || ?country = "Germany")
}
ORDER BY ASC(?priceAmount)
LIMIT 1""" .

