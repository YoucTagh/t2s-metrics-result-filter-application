<urn:uuid:38e1e667-3701-46d1-9f60-0f7265ad85fb> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f3116829-a642-4ba2-8823-a1b47da37087> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

