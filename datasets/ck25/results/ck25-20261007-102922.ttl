<urn:uuid:dfa0d56b-0e22-4f6f-905f-c17b7fbaf641> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:341d0944-e6ce-4313-a7fb-73320cb34030> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?productID ?productName ?widthMM WHERE {
  ?product a pv:Product .
  ?product pv:hasWidth_mm ?widthMM .
  FILTER (?widthMM IN (SELECT ?widthMM FROM (SELECT ?widthMM WHERE { ?p a pv:Product ; pv:hasWidth_mm ?widthMM }) ORDER BY DESC(?widthMM) LIMIT 10%))
}""" .

