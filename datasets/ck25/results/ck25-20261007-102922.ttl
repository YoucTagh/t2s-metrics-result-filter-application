<urn:uuid:4e9c3a90-fe93-4c8c-8e1b-69a0c544bcdd> a t2s:Score ;
    t2s:forMetric t2si:rouge_4 ;
    t2s:scoreValue 0.5777777777777778 .

<urn:uuid:4eabf5da-7cb3-450d-910b-f61685dfddc1> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:3077961d-21af-4205-9f10-2befd6688bf8> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}
""" .

