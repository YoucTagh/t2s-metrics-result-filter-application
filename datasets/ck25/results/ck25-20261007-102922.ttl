<urn:uuid:5d94b6d5-9415-4d2a-acf5-79c9711d692a> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:23e2d650-2040-4125-a5de-b1488923ec3a> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:weight_g ?weight_g .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  FILTER (?width_mm <= 15)
  FILTER (?depth_mm <= 15)
}
ORDER BY DESC(?weight_g)
LIMIT 1
""" .

<urn:uuid:5d968b72-6726-4c99-b28f-578ae6e806b4> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:774ece66-5938-4bc1-a897-0ba36590f61a> ;
    t2s:queryText """PREFIX ldco: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?manager WHERE {
  ldco:DataServicesDepartment ldco:hasManager ?manager .
}""" .

