    t2s:hasResultSet <urn:uuid:89b34549-f21e-420a-9c23-84839b6e1062> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

ASK
WHERE {
  { # all BOMs with parts from russia
    SELECT ?bom
    WHERE {
      ?bom pv:hasBomPart ?bomPart .
      ?bomPart pv:hasPart ?hw .
      ?hw pv:hasSupplier ?suppl .
      ?suppl pv:addressCountry ?country .
      FILTER (CONTAINS(LCASE(?country), LCASE("Russia")))
    }
  }

  # services eligible for parts associated with these BOMs?
  ?s a pv:Service .
  ?s pv:eligibleFor ?hw .
  ?bom pv:hasBomPart ?bomPart .
  ?bomPart pv:hasPart ?hw .
}
""" .

<urn:uuid:ea72d5ff-9b40-4ab5-99b5-3de4959ecfd7> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:5472ba72-a872-4a4e-bf9b-08a61ca55179> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?a ?b
WHERE {
  ?a pv:compatibleProduct ?b .
  FILTER (STR(?a) < STR(?b))
}
""" .

<urn:uuid:ea74550b-738d-40a5-95ed-42ba143acb51> a t2s:Score ;
