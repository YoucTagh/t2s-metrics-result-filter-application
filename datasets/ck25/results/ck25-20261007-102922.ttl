    t2s:hasResultSet <urn:uuid:0be55cc7-bf2a-4b29-8647-0d1c362484b5> ;
    t2s:queryText """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prod-vocab: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?supplier ?name WHERE {
  ?supplier rdf:type/rdfs:subClassOf* prod-vocab:Supplier .
  ?supplier prod-vocab:addressLocality "Toulouse" .
  OPTIONAL { ?supplier prod-vocab:name ?name }
}""" .

