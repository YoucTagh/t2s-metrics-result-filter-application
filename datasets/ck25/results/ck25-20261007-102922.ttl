<urn:uuid:95573105-321a-4d6d-978f-fb3f03e30809> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:98317ca3-9b80-4f2a-bf8e-0cf0ed5ffbc7> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" .

