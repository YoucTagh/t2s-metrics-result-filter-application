    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

