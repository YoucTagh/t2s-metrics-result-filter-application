<urn:uuid:e47bbcfc-9f08-428c-b9df-5fe7bc81b01c> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f3d730d9-55fd-49d8-add9-85a8473353a2> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" .

