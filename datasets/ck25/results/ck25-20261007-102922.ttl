<urn:uuid:897a989d-e357-4e06-8d27-7dc29d9f5851> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f5a6fe63-b666-425d-b972-027f54882351> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?a ?b
WHERE {
  ?a pv:compatibleProduct ?b .
  FILTER (STR(?a) < STR(?b))
}
""" .

