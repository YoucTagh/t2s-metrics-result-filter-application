<urn:uuid:06424008-dd4d-4211-94d0-144a1a013e68> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:6746d4e8-e3fd-4bf3-b79c-a7a52a818f79> ;
    t2s:queryText "SELECT ?bom (COUNT(?part) AS ?partCount) (SUM(?quantity) AS ?totalQuantity) WHERE { ?bom a :BillOfMaterial; :containsPart ?part. ?part :materialQuantity ?quantity. } GROUP BY ?bom HAVING (SUM(?quantity) > 600) ORDER BY DESC(?totalQuantity)" .

