<urn:uuid:9d127fa2-ce35-4c4e-8fcd-a2c52af91b98> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f1a069ae-70ff-4748-8f8c-0d3f02edbd39> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?property ?value WHERE {
  ?resource pv:areaOfExpertise ?value.
  FILTER (?resource IN (pv:Agent, pv:ProductCategory))
  FILTER (regex(str(?value), "Transistors", 'i'))
}""" .

