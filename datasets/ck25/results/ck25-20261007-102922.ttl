<urn:uuid:b6507157-3971-4cac-93ac-db03e4d25bea> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:347f6a1e-08d0-4e8a-99fc-8993a53eb838> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?country ?price
WHERE {
  ?sup a pv:Supplier ;
    pv:addressCountry ?country ;
  pv:name ?name .
  ?hw a pv:Hardware ;
  pv:price/pv:amount ?price ;
    pv:price/pv:currency "EUR" ;
    pv:hasSupplier ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 10
""" .

