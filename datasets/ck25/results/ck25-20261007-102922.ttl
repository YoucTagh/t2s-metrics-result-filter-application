    t2s:queryText "PREFIX : <http://ld.company.org/prod-vocab/> SELECT ?item ?width ?height ?depth WHERE { ?item a :Hardware ; :width_mm ?width ; :height_mm ?height ; :depth_mm ?depth . FILTER(?width > ?height && ?depth < 50) }" .

<urn:uuid:57181aa6-cc7e-4e26-bff2-6175d1e1b063> a t2s:Score ;
