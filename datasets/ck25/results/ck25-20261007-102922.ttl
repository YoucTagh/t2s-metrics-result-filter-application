<urn:uuid:d2539cad-9479-46b1-922c-1d7d19ccbf4e> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:e95d24c2-1f72-4a8b-97f3-ecab56252467> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

