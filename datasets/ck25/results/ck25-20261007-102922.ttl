<urn:uuid:df0270c3-7d46-4656-9819-057cfb0f1f45> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:47f1f980-53bb-4b07-98c5-7a1f43befbee> ;
    t2s:queryText """PREFIX : <http://ld.company.org/prod-vocab/>
SELECT ?supplier (AVG(?reliabilityIndex) AS ?averageReliability)
WHERE {
  ?product a :Hardware ;
          :hasSupplier ?supplier ;
          :reliabilityIndex ?reliabilityIndex.
}
GROUP BY ?supplier
ORDER BY DESC(?averageReliability)
LIMIT 5""" .

