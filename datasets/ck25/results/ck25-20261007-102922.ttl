<urn:uuid:d1b18987-910b-42cf-a0e7-4e83496fd0ad> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:f9a0a424-041e-401f-9569-cb2b9ab6ac4e> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?country ?price
WHERE {
  ?sup a pv:Supplier ;
    pv:addressCountry ?country ;
  pv:name ?name .
  ?hw a pv:Hardware ;
  pv:price/pv:amount ?price ;
    pv:price/pv:currency "EUR" ;
    pv:hasSupplier ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 10
""" .

