    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>PREFIX pv: <http://ld.company.org/prod-vocab/>PREFIX prodi: <http://ld.company.org/prod-instances/>SELECT DISTINCT ?departmentWHERE {    prodi:hw-M558-2275045 rdf:type pv:Hardware .    prodi:hw-M558-2275045 pv:hasProductManager ?manager .    ?manager pv:memberOf ?department .}""" .

