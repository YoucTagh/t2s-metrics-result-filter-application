<urn:uuid:73427638-ba6a-42b5-a1aa-fb64f54c0b07> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:aee28659-f008-4c89-b2e9-c6365cf19305> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?id ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name .
  FILTER NOT EXISTS { ?hw pv:hasProductManager/pv:name [] . }
}
""" .

