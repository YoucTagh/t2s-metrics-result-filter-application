<urn:uuid:251d6def-83ad-4be3-bf48-8e0d65bd3cc3> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:06f1613e-3c17-44eb-a73d-c470b7d5203d> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

