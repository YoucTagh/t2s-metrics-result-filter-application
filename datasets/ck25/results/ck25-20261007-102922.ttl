<urn:uuid:d0c0e4ce-5680-415f-8c02-0753595a53dc> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:76fa2cb9-1c9f-4c8d-ae2d-bb5092c9aada> ;
    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?empl ?name ?email ?phone
WHERE {
  ?emplClass rdfs:subClassOf* pv:Employee .
  ?empl a ?emplClass ;
      pv:name ?name ;
      pv:email ?email .
  OPTIONAL { ?empl pv:phone ?phone }
  FILTER NOT EXISTS { [] pv:hasManager ?empl . }
}
ORDER BY ?name
""" .

<urn:uuid:d0c2f5bf-db98-4a81-a13d-03e584210518> a t2s:Score ;
    t2s:forMetric t2si:jaccard ;
    t2s:scoreValue 0.30052604896197543 .

<urn:uuid:d0c49f21-a90b-41a8-a84f-1727f14d9c1b> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:8f42c8ae-e4ce-4791-8a0f-730671e273ff> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?department pv:name "Marketing" .
  ?person pv:memberOf ?department .
  ?person pv:email ?result .
  ?person pv:name ?name .
  FILTER (CONTAINS(?name, "Sabrina"))
}
""" .

