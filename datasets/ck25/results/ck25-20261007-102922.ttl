<urn:uuid:94e78eab-537c-473b-8acc-71d044d444a0> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:2715d233-b451-4ab3-bc19-32eb461ae615> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

