<urn:uuid:0ea5d4bd-7553-4e3b-aa86-d7ea47fc7ae6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:89c2bd72-10fa-44c8-914e-89a1012ee2f7> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?id ?name ?width
WHERE {
  { # get min-max range
    SELECT (MIN(?width) AS ?minW) (MAX(?width) AS ?maxW)
    WHERE {
      ?hw a pv:Hardware ;
        pv:width_mm ?width .
    }
  }

  # get 90. percentile
  BIND(?minW + (0.9 * (?maxW - ?minW)) AS ?pct90)

  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name ;
    pv:width_mm ?width .

  FILTER(?width >= ?pct90)
}
ORDER BY DESC(?width)
""" .

