<urn:uuid:fa7fcb0e-5bae-4721-8814-adbc165713c1> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:73824b81-30a7-4526-a8ad-c4233be21dd2> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

