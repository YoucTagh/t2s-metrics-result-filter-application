    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?empl ?name ?email ?phone
WHERE {
  ?emplClass rdfs:subClassOf* pv:Employee .
  ?empl a ?emplClass ;
      pv:name ?name ;
      pv:email ?email .
  OPTIONAL { ?empl pv:phone ?phone }
  FILTER NOT EXISTS { [] pv:hasManager ?empl . }
}
ORDER BY ?name
""" .

<urn:uuid:488439f4-2bad-4bad-a17b-4f1204938d90> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:28b9460b-8c03-48c3-a8b9-263fc7c6bb73> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (ROUND(AVG(?amt) * 100) / 100 AS ?avgEur) WHERE {
  ?sup a pv:Supplier ;
    pv:name ?name .
  ?hw pv:hasSupplier ?sup ;
    pv:price/pv:amount ?amt ;
    pv:price/pv:currency "EUR" .
}
GROUP BY ?sup ?name
""" .

