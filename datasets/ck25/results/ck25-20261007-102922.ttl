<urn:uuid:3f3c26aa-af06-4e38-bfdc-00dbf8d8b118> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:207b817c-591c-4661-a097-933a2a7b8d12> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

