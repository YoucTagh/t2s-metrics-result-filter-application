<urn:uuid:8708c2ff-cf94-4e78-bd5f-8df578e1fbcc> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:ee93f6bf-f137-4087-a711-969af3cfe9d9> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?product pv:hasSupplier ?result .
  ?product pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Compensator> .
  ?result pv:addressCountry "France" .
}
""" .

