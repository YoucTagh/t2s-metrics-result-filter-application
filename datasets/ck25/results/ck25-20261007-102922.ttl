<urn:uuid:eb351483-cb3e-44a9-859d-5b68b9c0dc85> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:8de38483-278d-4ccc-822b-c4dc0a7bdf96> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?supplier
WHERE {
  ?supplier a <http://example.com/supplier>.
  ?supplier <http://example.com/delivers> <http://example.com/Compensators>.
}""" .

