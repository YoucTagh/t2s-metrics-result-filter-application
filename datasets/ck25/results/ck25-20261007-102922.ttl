<urn:uuid:a29a987c-06bd-4209-a093-b1071dd682d5> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:4a931966-7bd8-405e-bfc3-1b430d8b63d1> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?department pv:name "Marketing" .
  ?person pv:memberOf ?department .
  ?person pv:email ?result .
  ?person pv:name ?name .
  FILTER (CONTAINS(?name, "Sabrina"))
}
