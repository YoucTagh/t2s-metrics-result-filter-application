<urn:uuid:8fa27def-3038-4c32-96d1-e5f159c4650a> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:23ce802a-e861-43c9-98f4-6830d5b9903f> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" .

