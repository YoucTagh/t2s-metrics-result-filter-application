<urn:uuid:731d9534-f295-4747-9dec-270d8aaa7761> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:0e735ffe-adba-403f-8602-dc62ed9633e7> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" .

