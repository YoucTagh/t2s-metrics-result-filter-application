<urn:uuid:ae7005cd-3fa1-4d1d-9c41-86d991f7c5c6> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:cad428ba-3ac2-4e2b-8567-6d08d138d957> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" .

