<urn:uuid:0d466529-4ae2-435d-bab9-1e93d9161701> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:051c1cff-4b52-4ff2-bbce-0ad779a387b6> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?person pv:memberOf <http://ld.company.org/prod-instances/dept-41622> .
  ?person pv:hasManager ?result .
}
""" .

<urn:uuid:0d490ef7-81f5-4943-b258-d641d46c5404> a t2s:Score ;
    t2s:forMetric t2si:query_execution ;
