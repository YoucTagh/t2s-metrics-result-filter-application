<urn:uuid:1105e9bf-b12f-4e0c-85e4-b259d03486a7> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:6027b3b0-3d3b-44bd-a18b-113a57d3b98d> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:weight_g ?weight_g .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  FILTER (?width_mm <= 15)
  FILTER (?depth_mm <= 15)
}
ORDER BY DESC(?weight_g)
LIMIT 1
""" .

