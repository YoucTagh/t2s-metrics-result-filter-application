<urn:uuid:1180c32c-5f34-4f0c-8e46-f6b105f5b8f5> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:1a10dc79-f648-43d1-9687-da2d5f0db3da> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}
""" .

