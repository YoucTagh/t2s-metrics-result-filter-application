<urn:uuid:0c7136ad-0ada-493e-953e-a582219c07d2> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:d78dd49e-7698-44b6-a746-719d6c1ca19b> ;
    t2s:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>PREFIX pv: <http://ld.company.org/prod-vocab/>SELECT DISTINCT ?managerName WHERE {  ?dept rdf:type pv:Department ;        pv:name "Data Services" ;        pv:responsibleFor ?manager .  ?manager rdf:type pv:Manager ;           pv:name ?managerName .}""" .

