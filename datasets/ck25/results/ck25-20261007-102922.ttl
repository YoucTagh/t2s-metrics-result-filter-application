    t2s:hasResultSet <urn:uuid:ff21152e-1ebb-4323-8507-1b5b520d0d26> ;
    t2s:queryText """
PREFIX ld: <http://ld.company.org/prod-vocab/>

ASK WHERE {
  ?emp ld:memberOf ?dept .
  FILTER NOT EXISTS {
    ?otherEmp ld:hasManager ?emp .
  }
}""" .

