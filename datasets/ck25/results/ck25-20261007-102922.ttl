<urn:uuid:f1f7e898-02a9-4d9a-a913-98a3df583c0a> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:0d8373b6-76c9-4ff6-9b61-ce5eb44eeaa3> ;
    t2s:queryText """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ecc: <https://ns.eccenca.com/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX dbpedia-owl: <http://dbpedia.org/ontology/>

SELECT ?product WHERE { 
    ?supplier a pv:Supplier ;
              pv:country <http://dbpedia.org/resource/United_States> .
    ?product pv:hasSupplier ?supplier .
    prodi:hw-U990 pv:compatibleProduct ?product .
}""" .

