<urn:uuid:1d33d42e-256e-4f42-99f3-4631befd7f7c> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:9bc70476-98c5-45c5-a3f3-5b41e4da2042> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?property ?value WHERE {
    ?supplier a pv:Supplier.
    FILTER (?supplier IN (<http://ld.company.org/prod-instances/suppl-fcdf3268-b0f0-4e2b-8fbd-6008cb4a6d0e>, <http://ld.company.org/prod-instances/suppl-f80817bf-7010-48c7-a3be-b015b09309d0>, <http://ld.company.org/prod-instances/suppl-feeda1ce-d6af-42b2-b6ff-7516ba39ad6c>))
    ?product a pv:Inductor.
    ?supplier pv:hasSupplier ?product.
    ?product pv:reliability ?value.
