<urn:uuid:c0f82616-cc73-4b73-a09b-9d0cb990a8a0> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:9f09545e-e918-4647-a849-efade7a0da47> ;
    t2s:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" .

