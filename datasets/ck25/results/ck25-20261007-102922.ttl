    t2s:queryText "SELECT ?category ?lightestItem ?heaviestItem WHERE { { SELECT ?category (MIN(?weight) AS ?minWeight) (MAX(?weight) AS ?maxWeight) WHERE { ?item a :HardwareItem; :category ?category; :weight ?weight. } GROUP BY ?category } { SELECT ?category ?lightestItem WHERE { ?lightestItem a :HardwareItem; :category ?category; :weight ?weight. } HAVING (MIN(?weight) = ?minWeight) } { SELECT ?category ?heaviestItem WHERE { ?heaviestItem a :HardwareItem; :category ?category; :weight ?weight. } HAVING (MAX(?weight) = ?maxWeight) } }" .

