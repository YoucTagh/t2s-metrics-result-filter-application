<urn:uuid:45d46680-ff62-4eb6-803f-86d65fb35a44> a t2s:Query ;
    t2s:hasResultSet <urn:uuid:c93249b2-875f-488c-98f2-386315ea4eb9> ;
    t2s:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" .

